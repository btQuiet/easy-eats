# PowerShell: set these variables before starting the server.
GENERATION_MODE=test
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Exact frontend origins, comma separated. Use the same hostname for web and API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
# No default operator password. Provision through: python -m app.admin create-operator
